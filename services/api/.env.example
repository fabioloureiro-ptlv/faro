# Copie para services/api/.env (a API lê sozinha ao subir). Nunca commitar o .env.

# --- Slack: aviso do teste pronto para configurar no DY ---
# App "Faro" criado com docs/slack-app-manifest.json → Install to Workspace → Bot User OAuth Token
FARO_SLACK_BOT_TOKEN=
# Canal do aviso (ID ou #nome). Canal de teste combinado em 15/10:
FARO_SLACK_CHANNEL=C0C9NPGAQKU
# Quem mais marcar em todo aviso, além do PM que preencheu o teste (e-mails, separados por vírgula)
FARO_SLACK_MENTIONS=
# Alternativa sem app (só posta, não marca ninguém): Incoming Webhook do canal
# FARO_SLACK_WEBHOOK_URL=

# --- Jira Cloud: card com a ficha do DY ---
FARO_JIRA_BASE_URL=https://petlove.atlassian.net
# Seu e-mail do Atlassian e um token de API (https://id.atlassian.com/manage-profile/security/api-tokens)
FARO_JIRA_EMAIL=
FARO_JIRA_API_TOKEN=
# Projeto onde o card nasce. HTMD = "[Hackapet] [Teste] Marketing Data" (projeto de teste, seguro para experimentar).
# Candidato para valer: MS = "Marketing Data" (time que roda as consultas do roadmap). Confirmar com o time.
FARO_JIRA_PROJECT_KEY=HTMD
FARO_JIRA_ISSUE_TYPE=Task

# --- Link "ficha e design" na mensagem (também é a origem liberada no CORS) ---
FARO_WEB_ORIGIN=http://localhost:3000
