{
  "name": "@faro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./experiments/governance": "./src/painel/governance/index.ts",
    "./experiments/status": "./src/painel/status/index.ts",
    "./resultados/roadmap": "./src/resultados/roadmap/index.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "job:dy-consistency": "node src/jobs/dy-consistency.ts",
    "job:sync-dy": "node src/jobs/sync-dy-campaigns.ts",
    "job:publish-audiences": "node src/publico/jobs/publish-audiences.ts",
    "job:sync-results": "node src/resultados/jobs/sync-results.ts",
    "job:sync-roadmap": "node src/resultados/jobs/sync-roadmap.ts",
    "typecheck": "tsc -p tsconfig.json",
    "job:anuncio": "node --env-file-if-exists=.env src/anuncio/jobs/anunciar.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@faro/config-core": "0.1.0",
    "@faro/contracts": "0.1.0",
    "@faro/stats": "0.1.0",
    "@fastify/cors": "^11.3.1",
    "@google-cloud/bigquery": "^9.3.0",
    "@google-cloud/cloud-sql-connector": "^1.12.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0"
  }
}
