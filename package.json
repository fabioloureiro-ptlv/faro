{
  "name": "faro",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:api": "npm run dev -w @faro/api",
    "dev:web": "npm run dev -w @faro/web",
    "job:dy-consistency": "npm run job:dy-consistency -w @faro/api --",
    "job:sync-roadmap": "npm run job:sync-roadmap -w @faro/api --",
    "job:anuncio": "npm run job:anuncio -w @faro/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
